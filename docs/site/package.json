{
  "name": "@sudosylabs/proctor-docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "npm run generate:diagrams && npm run generate:asyncapi && npm run generate:openapi && npm run generate:problems && docusaurus start",
    "build": "npm run generate:diagrams && npm run generate:asyncapi && npm run generate:openapi && npm run generate:problems && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "generate:design-system": "node scripts/generate-design-system.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "test:design-system": "node --test design-system/index.test.mjs",
    "generate:diagrams": "node scripts/generate-diagrams.mjs",
    "test:diagrams": "node --test diagrams/index.test.mjs",
    "generate:glossary": "node scripts/generate-glossary.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "test:glossary": "node --test glossary/index.test.mjs",
    "generate:search": "node scripts/generate-search-index.mjs",
    "check:search": "node scripts/check-search-index.mjs",
    "test:search": "node --test search/index.test.mjs",
    "test:navigation": "node --test navigation.test.mjs",
    "generate:technical-reference": "node scripts/technical-reference.mjs",
    "check:technical-reference": "node scripts/technical-reference.mjs --check",
    "generate:openapi": "npm run generate:openapi:spec && npm run generate:openapi:reference",
    "generate:openapi:spec": "node scripts/sync-openapi.mjs",
    "generate:openapi:reference": "node scripts/generate-api-reference.mjs",
    "generate:asyncapi": "node scripts/generate-asyncapi-reference.mjs",
    "generate:problems": "node scripts/generate-problem-pages.mjs",
    "test:problems": "node --test problems/index.test.mjs",
    "audit:openapi": "node scripts/audit-openapi.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test:assets": "node --test scripts/asset-registry.test.mjs",
    "test:openapi-audit": "node --test scripts/openapi-audit.test.mjs",
    "test:openapi-reference": "node --test api-reference/index.test.mjs",
    "test:asyncapi-reference": "node --test scripts/asyncapi-reference.test.mjs",
    "validate:routes": "node scripts/authored-route-references.mjs",
    "test:routes": "node --test scripts/authored-route-references.test.mjs",
    "validate": "npm run check:design-system && npm run test:design-system && npm run check:glossary && npm run test:glossary && npm run check:search && npm run test:search && npm run test:navigation && npm run check:technical-reference && node scripts/validate-content.mjs && npm run validate:routes && npm run test:routes && npm run test:diagrams && npm run validate:assets && npm run test:assets && npm run test:openapi-audit && npm run test:openapi-reference && npm run test:asyncapi-reference && npm run test:problems && npm run audit:openapi",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run generate:diagrams && npm run generate:asyncapi && npm run generate:openapi && npm run generate:problems && npm run typecheck && docusaurus build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "js-yaml": "4.3.2",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.7",
    "serialize-javascript": "7.1.0",
    "tinypool": "2.2.0",
    "uuid": "11.1.1",
    "yaml": "1.10.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
