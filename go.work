go 1.26.11

use (
	./packages/cache
	./packages/mail
	./packages/vfs
	./server
)

// The server's graph still reaches the 2019 monolithic genproto (through
// gojay and cloud.google.com/go v0.37.0). In the workspace that version
// clashes with the split googleapis/rpc and googleapis/api modules, and
// grpc's imports become ambiguous. go mod tidy, and so Dependabot, drops
// the same pin from server/go.mod, so it lives here where tidy never looks.
replace google.golang.org/genproto => google.golang.org/genproto v0.0.0-20260819154853-08b0e4226688

replace (
	github.com/sudosylabs/proctor/packages/cache v0.0.0-20261111213109-79e3170a5027 => ./packages/cache
	github.com/sudosylabs/proctor/packages/mail v0.0.0-20261111210501-268c5a24e5c4 => ./packages/mail
	github.com/sudosylabs/proctor/packages/vfs v0.0.0-20261111210501-268c5a24e5c4 => ./packages/vfs
)
