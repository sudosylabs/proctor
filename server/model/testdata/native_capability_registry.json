{
  "description": "Proctor native capability registry: capabilities, typed rule fields, reasons, baseline rules and fact schemas, generated from the Rust types.",
  "fact_schemas": {
    "camera": {
      "state": {
        "$defs": {
          "Coverage": {
            "oneOf": [
              {
                "enum": [
                  "readiness_and_use",
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "const": "readiness_only",
                "description": "Devices and readiness are read; other-application use is not readable here.",
                "type": "string"
              }
            ]
          },
          "Known": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          },
          "Readiness": {
            "enum": [
              "ready",
              "not_ready",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "The camera state. The permission is in the envelope.",
        "properties": {
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "in_use_by_other_app": {
            "$ref": "#/$defs/Known"
          },
          "physical_devices": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "ready": {
            "$ref": "#/$defs/Readiness",
            "description": "A physical camera is connected and not suspended, and the permission is granted."
          },
          "virtual_devices": {
            "description": "Software cameras, and cameras that cannot be classified. They never make the camera ready.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "coverage",
          "physical_devices",
          "virtual_devices",
          "ready",
          "in_use_by_other_app"
        ],
        "title": "CameraState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "physical_devices": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "virtual_devices": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "physical_devices",
          "virtual_devices"
        ],
        "title": "CameraSummary",
        "type": "object"
      }
    },
    "candidate_window": {
      "state": {
        "$defs": {
          "Focus": {
            "enum": [
              "focused",
              "not_focused",
              "unknown"
            ],
            "type": "string"
          },
          "Occlusion": {
            "enum": [
              "none",
              "covered",
              "unknown"
            ],
            "type": "string"
          },
          "Placement": {
            "enum": [
              "maximized",
              "normal",
              "minimized",
              "fullscreen",
              "unknown"
            ],
            "type": "string"
          },
          "Presence": {
            "enum": [
              "present",
              "absent"
            ],
            "type": "string"
          },
          "Protection": {
            "enum": [
              "verified",
              "failed",
              "unknown"
            ],
            "type": "string"
          },
          "Visibility": {
            "enum": [
              "visible",
              "hidden",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "close_attempts": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "content_protection": {
            "$ref": "#/$defs/Protection"
          },
          "focus": {
            "$ref": "#/$defs/Focus"
          },
          "occlusion": {
            "$ref": "#/$defs/Occlusion"
          },
          "placement": {
            "$ref": "#/$defs/Placement"
          },
          "presence": {
            "$ref": "#/$defs/Presence"
          },
          "visibility": {
            "$ref": "#/$defs/Visibility"
          }
        },
        "required": [
          "presence",
          "focus",
          "visibility",
          "placement",
          "content_protection",
          "occlusion",
          "close_attempts"
        ],
        "title": "CandidateWindowState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "clipboard": {
      "state": {
        "$defs": {
          "Coverage": {
            "enum": [
              "counter_polling",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "changes": {
            "description": "Host clipboard changes since this capability was activated.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          }
        },
        "required": [
          "coverage",
          "changes"
        ],
        "title": "ClipboardState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "display": {
      "state": {
        "$defs": {
          "Connection": {
            "enum": [
              "direct",
              "indirect",
              "unknown"
            ],
            "type": "string"
          },
          "DisplayKind": {
            "enum": [
              "physical",
              "virtual",
              "wireless",
              "remote",
              "specialized",
              "unknown"
            ],
            "type": "string"
          },
          "DisplayTarget": {
            "additionalProperties": false,
            "description": "One display. `target_id` is opaque and stable only within one agent session.",
            "properties": {
              "active": {
                "type": "boolean"
              },
              "built_in": {
                "type": "boolean"
              },
              "connection": {
                "$ref": "#/$defs/Connection"
              },
              "kind": {
                "$ref": "#/$defs/DisplayKind"
              },
              "mirror_of": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "power": {
                "$ref": "#/$defs/Power"
              },
              "primary": {
                "$ref": "#/$defs/Primary"
              },
              "target_id": {
                "type": "string"
              }
            },
            "required": [
              "target_id",
              "active",
              "built_in",
              "kind",
              "connection",
              "power",
              "primary"
            ],
            "type": "object"
          },
          "Power": {
            "enum": [
              "awake",
              "asleep",
              "unknown"
            ],
            "type": "string"
          },
          "Primary": {
            "enum": [
              "primary",
              "not_primary",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "targets": {
            "items": {
              "$ref": "#/$defs/DisplayTarget"
            },
            "type": "array"
          }
        },
        "required": [
          "targets"
        ],
        "title": "DisplayState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Derived only from the targets; sent with every fact.",
        "properties": {
          "active_physical": {
            "description": "Physical, active and not a mirror.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "active_total": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "connected_total": {
            "description": "Every connected target, including inactive, asleep and mirrored ones.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "mirrored": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "remote": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "specialized": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "unknown_kind": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "virtual": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "wireless": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "active_physical",
          "active_total",
          "connected_total",
          "mirrored",
          "virtual",
          "wireless",
          "remote",
          "specialized",
          "unknown_kind"
        ],
        "title": "DisplaySummary",
        "type": "object"
      }
    },
    "interactive_session": {
      "state": {
        "$defs": {
          "ConsoleOwner": {
            "enum": [
              "candidate",
              "other_human",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "Coverage": {
            "enum": [
              "full_lifecycle",
              "snapshot_only",
              "unavailable"
            ],
            "type": "string"
          },
          "Lock": {
            "enum": [
              "unlocked",
              "locked",
              "unknown"
            ],
            "type": "string"
          },
          "RemoteAttachment": {
            "enum": [
              "absent",
              "present",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "console_owner": {
            "$ref": "#/$defs/ConsoleOwner"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "lock": {
            "$ref": "#/$defs/Lock"
          },
          "other_human_sessions": {
            "description": "`None` when the platform cannot count other sessions.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "remote_attachment": {
            "$ref": "#/$defs/RemoteAttachment"
          }
        },
        "required": [
          "coverage",
          "console_owner",
          "lock",
          "remote_attachment"
        ],
        "title": "InteractiveSessionState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "microphone": {
      "state": {
        "$defs": {
          "Coverage": {
            "oneOf": [
              {
                "enum": [
                  "readiness_and_use",
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "const": "readiness_only",
                "description": "Devices and readiness are read; other-application use is not readable here.",
                "type": "string"
              }
            ]
          },
          "Known": {
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          },
          "Readiness": {
            "enum": [
              "ready",
              "not_ready",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "The microphone state. The permission is in the envelope.",
        "properties": {
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "devices": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "in_use_by_other_app": {
            "$ref": "#/$defs/Known"
          },
          "ready": {
            "$ref": "#/$defs/Readiness",
            "description": "A microphone is available and the permission is granted."
          }
        },
        "required": [
          "coverage",
          "devices",
          "ready",
          "in_use_by_other_app"
        ],
        "title": "MicrophoneState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "devices": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "devices"
        ],
        "title": "MicrophoneSummary",
        "type": "object"
      }
    },
    "network": {
      "state": {
        "$defs": {
          "ManagedVpn": {
            "enum": [
              "inactive",
              "active",
              "unknown"
            ],
            "type": "string"
          },
          "Proxy": {
            "enum": [
              "none",
              "manual",
              "automatic_config",
              "auto_detect",
              "unknown"
            ],
            "type": "string"
          },
          "Tunnel": {
            "additionalProperties": false,
            "description": "One active tunnel. `interface_id` is opaque and stable within one agent session.",
            "properties": {
              "class": {
                "$ref": "#/$defs/TunnelClass"
              },
              "interface_id": {
                "type": "string"
              }
            },
            "required": [
              "interface_id",
              "class"
            ],
            "type": "object"
          },
          "TunnelClass": {
            "enum": [
              "point_to_point",
              "packet_tunnel",
              "virtual_ethernet",
              "managed_vpn",
              "other"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Only selected sub-categories appear; an unselected one is absent, not empty.",
        "properties": {
          "managed_vpn": {
            "anyOf": [
              {
                "$ref": "#/$defs/ManagedVpn"
              },
              {
                "type": "null"
              }
            ]
          },
          "route_generation": {
            "description": "Rises each time the routing table changes. A route change alone is never a violation.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "system_proxy": {
            "anyOf": [
              {
                "$ref": "#/$defs/Proxy"
              },
              {
                "type": "null"
              }
            ]
          },
          "tunnels": {
            "items": {
              "$ref": "#/$defs/Tunnel"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "NetworkState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Tunnel counts by class, derived only from `tunnels`.",
        "properties": {
          "managed_vpn_tunnels": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "packet_tunnel": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "point_to_point": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tunnels_total": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "virtual_ethernet": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "tunnels_total",
          "point_to_point",
          "packet_tunnel",
          "virtual_ethernet",
          "managed_vpn_tunnels"
        ],
        "title": "NetworkSummary",
        "type": "object"
      }
    },
    "printing": {
      "state": {
        "$defs": {
          "Coverage": {
            "oneOf": [
              {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "const": "monitored_scheduler",
                "description": "Every job the scheduler accepts is seen, including jobs that finish between reads.",
                "type": "string"
              },
              {
                "const": "snapshot_only",
                "description": "One read of the jobs present now; a job that came and went is not seen.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "blocked_print_commands": {
            "description": "Print commands the `CandidateWindow` refused since observation started.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "candidate_jobs": {
            "description": "Active jobs owned by the candidate's account.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "candidate_jobs_since_start": {
            "description": "Candidate jobs the scheduler accepted since observation started, finished ones included.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "other_jobs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "unknown_jobs": {
            "description": "Active jobs whose owner the scheduler did not state.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "coverage",
          "candidate_jobs",
          "other_jobs",
          "unknown_jobs",
          "candidate_jobs_since_start",
          "blocked_print_commands"
        ],
        "title": "PrintState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "candidate_jobs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "unknown_jobs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "candidate_jobs",
          "unknown_jobs"
        ],
        "title": "PrintSummary",
        "type": "object"
      }
    },
    "process_application": {
      "state": {
        "$defs": {
          "Coverage": {
            "oneOf": [
              {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "const": "full_lifecycle",
                "description": "Every process start and exit is seen (the privileged components).",
                "type": "string"
              },
              {
                "const": "snapshot_only",
                "description": "Periodic snapshots: a short-lived process can come and go unseen.",
                "type": "string"
              }
            ]
          },
          "RuleMatch": {
            "additionalProperties": false,
            "description": "One application rule's match. `matched` means the condition is violated.",
            "properties": {
              "catalog_app_ids": {
                "description": "Blocklist rules: the catalog applications found. Always empty for allowlist rules.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "matched": {
                "type": "boolean"
              },
              "rule_id": {
                "type": "string"
              }
            },
            "required": [
              "rule_id",
              "matched",
              "catalog_app_ids"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "checking": {
            "description": "New processes whose identity is still being verified.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "rule_matches": {
            "items": {
              "$ref": "#/$defs/RuleMatch"
            },
            "type": "array"
          }
        },
        "required": [
          "coverage",
          "checking",
          "rule_matches"
        ],
        "title": "ProcessState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "checking": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "checking"
        ],
        "title": "ProcessSummary",
        "type": "object"
      }
    },
    "removable_storage": {
      "state": {
        "$defs": {
          "Coverage": {
            "oneOf": [
              {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "const": "block_and_portable",
                "description": "Disks and portable devices are both read.",
                "type": "string"
              },
              {
                "const": "block_only",
                "description": "Disks are read; this platform cannot read portable devices.",
                "type": "string"
              }
            ]
          },
          "Device": {
            "additionalProperties": false,
            "description": "One attached device. `device_id` is opaque and stable within one agent session.",
            "properties": {
              "device_id": {
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/Kind"
              },
              "mounted": {
                "$ref": "#/$defs/Known",
                "description": "Whether a file system on it is mounted. Unmounted storage still counts as attached."
              },
              "transport": {
                "$ref": "#/$defs/Transport"
              },
              "writable": {
                "$ref": "#/$defs/Known"
              }
            },
            "required": [
              "device_id",
              "kind",
              "transport",
              "mounted",
              "writable"
            ],
            "type": "object"
          },
          "Kind": {
            "enum": [
              "block_storage",
              "portable_device"
            ],
            "type": "string"
          },
          "Known": {
            "description": "A yes/no the OS may not state.",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          },
          "Transport": {
            "enum": [
              "usb",
              "thunderbolt",
              "sd",
              "other",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "devices": {
            "description": "At most [`MAX_DEVICES`], ordered by identity.",
            "items": {
              "$ref": "#/$defs/Device"
            },
            "type": "array"
          }
        },
        "required": [
          "coverage",
          "devices"
        ],
        "title": "StorageState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Device counts by kind, derived only from the read devices.",
        "properties": {
          "block_storage": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "portable_devices": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "block_storage",
          "portable_devices"
        ],
        "title": "StorageSummary",
        "type": "object"
      }
    },
    "screen_recording": {
      "state": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "free_space_mib": {
            "description": "Free space for this account on the app's data volume; absent when unreadable.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "title": "ScreenRecordingState",
        "type": "object"
      },
