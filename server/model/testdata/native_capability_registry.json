{
  "description": "Proctor native capability registry: capabilities, typed rule fields, reasons, baseline rules and fact schemas, generated from the Rust types.",
  "fact_schemas": {
    "candidate_window": {
      "state": {
        "$defs": {
          "Focus": {
            "enum": [
              "focused",
              "not_focused",
              "unknown"
            ],
            "type": "string"
          },
          "Occlusion": {
            "enum": [
              "none",
              "covered",
              "unknown"
            ],
            "type": "string"
          },
          "Placement": {
            "enum": [
              "maximized",
              "normal",
              "minimized",
              "fullscreen",
              "unknown"
            ],
            "type": "string"
          },
          "Presence": {
            "enum": [
              "present",
              "absent"
            ],
            "type": "string"
          },
          "Protection": {
            "enum": [
              "verified",
              "failed",
              "unknown"
            ],
            "type": "string"
          },
          "Visibility": {
            "enum": [
              "visible",
              "hidden",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "close_attempts": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "content_protection": {
            "$ref": "#/$defs/Protection"
          },
          "focus": {
            "$ref": "#/$defs/Focus"
          },
          "occlusion": {
            "$ref": "#/$defs/Occlusion"
          },
          "placement": {
            "$ref": "#/$defs/Placement"
          },
          "presence": {
            "$ref": "#/$defs/Presence"
          },
          "visibility": {
            "$ref": "#/$defs/Visibility"
          }
        },
        "required": [
          "presence",
          "focus",
          "visibility",
          "placement",
          "content_protection",
          "occlusion",
          "close_attempts"
        ],
        "title": "CandidateWindowState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "display": {
      "state": {
        "$defs": {
          "Connection": {
            "enum": [
              "direct",
              "indirect",
              "unknown"
            ],
            "type": "string"
          },
          "DisplayKind": {
            "enum": [
              "physical",
              "virtual",
              "wireless",
              "remote",
              "specialized",
              "unknown"
            ],
            "type": "string"
          },
          "DisplayTarget": {
            "additionalProperties": false,
            "description": "One display. `target_id` is opaque and stable only within one agent session.",
            "properties": {
              "active": {
                "type": "boolean"
              },
              "built_in": {
                "type": "boolean"
              },
              "connection": {
                "$ref": "#/$defs/Connection"
              },
              "kind": {
                "$ref": "#/$defs/DisplayKind"
              },
              "mirror_of": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "power": {
                "$ref": "#/$defs/Power"
              },
              "primary": {
                "$ref": "#/$defs/Primary"
              },
              "target_id": {
                "type": "string"
              }
            },
            "required": [
              "target_id",
              "active",
              "built_in",
              "kind",
              "connection",
              "power",
              "primary"
            ],
            "type": "object"
          },
          "Power": {
            "enum": [
              "awake",
              "asleep",
              "unknown"
            ],
            "type": "string"
          },
          "Primary": {
            "enum": [
              "primary",
              "not_primary",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "targets": {
            "items": {
              "$ref": "#/$defs/DisplayTarget"
            },
            "type": "array"
          }
        },
        "required": [
          "targets"
        ],
        "title": "DisplayState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Derived only from the targets; sent with every fact.",
        "properties": {
          "active_physical": {
            "description": "Physical, active and not a mirror.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "active_total": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "connected_total": {
            "description": "Every connected target, including inactive, asleep and mirrored ones.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "mirrored": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "remote": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "specialized": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "unknown_kind": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "virtual": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "wireless": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "active_physical",
          "active_total",
          "connected_total",
          "mirrored",
          "virtual",
          "wireless",
          "remote",
          "specialized",
          "unknown_kind"
        ],
        "title": "DisplaySummary",
        "type": "object"
      }
    },
    "interactive_session": {
      "state": {
        "$defs": {
          "ConsoleOwner": {
            "enum": [
              "candidate",
              "other_human",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "Coverage": {
            "enum": [
              "full_lifecycle",
              "snapshot_only",
              "unavailable"
            ],
            "type": "string"
          },
          "Lock": {
            "enum": [
              "unlocked",
              "locked",
              "unknown"
            ],
            "type": "string"
          },
          "RemoteAttachment": {
            "enum": [
              "absent",
              "present",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "console_owner": {
            "$ref": "#/$defs/ConsoleOwner"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "lock": {
            "$ref": "#/$defs/Lock"
          },
          "other_human_sessions": {
            "description": "`None` when the platform cannot count other sessions.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "remote_attachment": {
            "$ref": "#/$defs/RemoteAttachment"
          }
        },
        "required": [
          "coverage",
          "console_owner",
          "lock",
          "remote_attachment"
        ],
        "title": "InteractiveSessionState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  },
  "registry": {
    "baseline_rules": [
      {
        "capability": "display",
        "mode": "enforce",
        "phase": "both",
        "reason": "display.single_display_required",
        "requirement": {
          "All": {
            "conditions": [
              {
                "Compare": {
                  "field": "display.summary.connected_total",
                  "op": "eq",
                  "value": 1
                }
              },
              {
                "Compare": {
                  "field": "display.summary.active_physical",
                  "op": "eq",
                  "value": 1
                }
              }
            ]
          }
        },
        "rule_id": "baseline.single_display"
      },
      {
        "capability": "candidate_window",
        "mode": "enforce",
        "phase": "participation",
        "reason": "candidate_window.window_required",
        "requirement": {
          "All": {
            "conditions": [
              {
                "Compare": {
                  "field": "candidate_window.presence",
                  "op": "eq",
                  "value": "present"
                }
              },
              {
                "Compare": {
                  "field": "candidate_window.placement",
                  "op": "eq",
                  "value": "maximized"
                }
              },
              {
                "Compare": {
                  "field": "candidate_window.content_protection",
                  "op": "eq",
                  "value": "verified"
                }
              }
            ]
          }
        },
        "rule_id": "baseline.window"
      },
      {
        "capability": "interactive_session",
        "mode": "enforce",
        "phase": "both",
        "reason": "interactive_session.single_session_required",
        "requirement": {
          "All": {
            "conditions": [
              {
                "Compare": {
                  "field": "interactive_session.console_owner",
                  "op": "eq",
                  "value": "candidate"
                }
              },
              {
                "Compare": {
                  "field": "interactive_session.lock",
                  "op": "eq",
                  "value": "unlocked"
                }
              },
              {
                "Compare": {
                  "field": "interactive_session.remote_attachment",
                  "op": "eq",
                  "value": "absent"
                }
              },
              {
                "Compare": {
                  "field": "interactive_session.other_human_sessions",
                  "op": "eq",
                  "value": 0
                }
              }
            ]
          }
        },
        "rule_id": "baseline.session"
      }
    ],
    "capabilities": [
      {
        "app_conditions": false,
        "categories": [],
        "fields": [
          {
            "max": 32,
            "name": "display.summary.active_physical",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.active_total",
            "type": "count"
          },
          {
