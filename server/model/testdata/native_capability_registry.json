{
  "description": "Proctor native capability registry: capabilities, typed rule fields, reasons, baseline rules and fact schemas, generated from the Rust types.",
  "fact_schemas": {
    "candidate_window": {
      "state": {
        "$defs": {
          "Focus": {
            "enum": [
              "focused",
              "not_focused",
              "unknown"
            ],
            "type": "string"
          },
          "Occlusion": {
            "enum": [
              "none",
              "covered",
              "unknown"
            ],
            "type": "string"
          },
          "Placement": {
            "enum": [
              "maximized",
              "normal",
              "minimized",
              "fullscreen",
              "unknown"
            ],
            "type": "string"
          },
          "Presence": {
            "enum": [
              "present",
              "absent"
            ],
            "type": "string"
          },
          "Protection": {
            "enum": [
              "verified",
              "failed",
              "unknown"
            ],
            "type": "string"
          },
          "Visibility": {
            "enum": [
              "visible",
              "hidden",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "close_attempts": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "content_protection": {
            "$ref": "#/$defs/Protection"
          },
          "focus": {
            "$ref": "#/$defs/Focus"
          },
          "occlusion": {
            "$ref": "#/$defs/Occlusion"
          },
          "placement": {
            "$ref": "#/$defs/Placement"
          },
          "presence": {
            "$ref": "#/$defs/Presence"
          },
          "visibility": {
            "$ref": "#/$defs/Visibility"
          }
        },
        "required": [
          "presence",
          "focus",
          "visibility",
          "placement",
          "content_protection",
          "occlusion",
          "close_attempts"
        ],
        "title": "CandidateWindowState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "clipboard": {
      "state": {
        "$defs": {
          "Coverage": {
            "enum": [
              "counter_polling",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "changes": {
            "description": "Host clipboard changes since this capability was activated.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          }
        },
        "required": [
          "coverage",
          "changes"
        ],
        "title": "ClipboardState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "display": {
      "state": {
        "$defs": {
          "Connection": {
            "enum": [
              "direct",
              "indirect",
              "unknown"
            ],
            "type": "string"
          },
          "DisplayKind": {
            "enum": [
              "physical",
              "virtual",
              "wireless",
              "remote",
              "specialized",
              "unknown"
            ],
            "type": "string"
          },
          "DisplayTarget": {
            "additionalProperties": false,
            "description": "One display. `target_id` is opaque and stable only within one agent session.",
            "properties": {
              "active": {
                "type": "boolean"
              },
              "built_in": {
                "type": "boolean"
              },
              "connection": {
                "$ref": "#/$defs/Connection"
              },
              "kind": {
                "$ref": "#/$defs/DisplayKind"
              },
              "mirror_of": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "power": {
                "$ref": "#/$defs/Power"
              },
              "primary": {
                "$ref": "#/$defs/Primary"
              },
              "target_id": {
                "type": "string"
              }
            },
            "required": [
              "target_id",
              "active",
              "built_in",
              "kind",
              "connection",
              "power",
              "primary"
            ],
            "type": "object"
          },
          "Power": {
            "enum": [
              "awake",
              "asleep",
              "unknown"
            ],
            "type": "string"
          },
          "Primary": {
            "enum": [
              "primary",
              "not_primary",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "targets": {
            "items": {
              "$ref": "#/$defs/DisplayTarget"
            },
            "type": "array"
          }
        },
        "required": [
          "targets"
        ],
        "title": "DisplayState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Derived only from the targets; sent with every fact.",
        "properties": {
          "active_physical": {
            "description": "Physical, active and not a mirror.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "active_total": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "connected_total": {
            "description": "Every connected target, including inactive, asleep and mirrored ones.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "mirrored": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "remote": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "specialized": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "unknown_kind": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "virtual": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "wireless": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "active_physical",
          "active_total",
          "connected_total",
          "mirrored",
          "virtual",
          "wireless",
          "remote",
          "specialized",
          "unknown_kind"
        ],
        "title": "DisplaySummary",
        "type": "object"
      }
    },
    "interactive_session": {
      "state": {
        "$defs": {
          "ConsoleOwner": {
            "enum": [
              "candidate",
              "other_human",
              "none",
              "unknown"
            ],
            "type": "string"
          },
          "Coverage": {
            "enum": [
              "full_lifecycle",
              "snapshot_only",
              "unavailable"
            ],
            "type": "string"
          },
          "Lock": {
            "enum": [
              "unlocked",
              "locked",
              "unknown"
            ],
            "type": "string"
          },
          "RemoteAttachment": {
            "enum": [
              "absent",
              "present",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "console_owner": {
            "$ref": "#/$defs/ConsoleOwner"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "lock": {
            "$ref": "#/$defs/Lock"
          },
          "other_human_sessions": {
            "description": "`None` when the platform cannot count other sessions.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "remote_attachment": {
            "$ref": "#/$defs/RemoteAttachment"
          }
        },
        "required": [
          "coverage",
          "console_owner",
          "lock",
          "remote_attachment"
        ],
        "title": "InteractiveSessionState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    },
    "network": {
      "state": {
        "$defs": {
          "ManagedVpn": {
            "enum": [
              "inactive",
              "active",
              "unknown"
            ],
            "type": "string"
          },
          "Proxy": {
            "enum": [
              "none",
              "manual",
              "automatic_config",
              "auto_detect",
              "unknown"
            ],
            "type": "string"
          },
          "Tunnel": {
            "additionalProperties": false,
            "description": "One active tunnel. `interface_id` is opaque and stable within one agent session.",
            "properties": {
              "class": {
                "$ref": "#/$defs/TunnelClass"
              },
              "interface_id": {
                "type": "string"
              }
            },
            "required": [
              "interface_id",
              "class"
            ],
            "type": "object"
          },
          "TunnelClass": {
            "enum": [
              "point_to_point",
              "packet_tunnel",
              "virtual_ethernet",
              "managed_vpn",
              "other"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Only selected sub-categories appear; an unselected one is absent, not empty.",
        "properties": {
          "managed_vpn": {
            "anyOf": [
              {
                "$ref": "#/$defs/ManagedVpn"
              },
              {
                "type": "null"
              }
            ]
          },
          "route_generation": {
            "description": "Rises each time the routing table changes. A route change alone is never a violation.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "system_proxy": {
            "anyOf": [
              {
                "$ref": "#/$defs/Proxy"
              },
              {
                "type": "null"
              }
            ]
          },
          "tunnels": {
            "items": {
              "$ref": "#/$defs/Tunnel"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "title": "NetworkState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Tunnel counts by class, derived only from `tunnels`.",
        "properties": {
          "managed_vpn_tunnels": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "packet_tunnel": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "point_to_point": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "tunnels_total": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "virtual_ethernet": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "tunnels_total",
          "point_to_point",
          "packet_tunnel",
          "virtual_ethernet",
          "managed_vpn_tunnels"
        ],
        "title": "NetworkSummary",
        "type": "object"
      }
    },
    "printing": {
      "state": {
        "$defs": {
          "Coverage": {
            "oneOf": [
              {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "const": "monitored_scheduler",
                "description": "Every job the scheduler accepts is seen, including jobs that finish between reads.",
                "type": "string"
              },
              {
                "const": "snapshot_only",
                "description": "One read of the jobs present now; a job that came and went is not seen.",
                "type": "string"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "blocked_print_commands": {
            "description": "Print commands the `CandidateWindow` refused since observation started.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "candidate_jobs": {
            "description": "Active jobs owned by the candidate's account.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "candidate_jobs_since_start": {
            "description": "Candidate jobs the scheduler accepted since observation started, finished ones included.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "other_jobs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "unknown_jobs": {
            "description": "Active jobs whose owner the scheduler did not state.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "coverage",
          "candidate_jobs",
          "other_jobs",
          "unknown_jobs",
          "candidate_jobs_since_start",
          "blocked_print_commands"
        ],
        "title": "PrintState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "candidate_jobs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "unknown_jobs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "candidate_jobs",
          "unknown_jobs"
        ],
        "title": "PrintSummary",
        "type": "object"
      }
    },
    "removable_storage": {
      "state": {
        "$defs": {
          "Coverage": {
            "oneOf": [
              {
                "enum": [
                  "unavailable"
                ],
                "type": "string"
              },
              {
                "const": "block_and_portable",
                "description": "Disks and portable devices are both read.",
                "type": "string"
              },
              {
                "const": "block_only",
                "description": "Disks are read; this platform cannot read portable devices.",
                "type": "string"
              }
            ]
          },
          "Device": {
            "additionalProperties": false,
            "description": "One attached device. `device_id` is opaque and stable within one agent session.",
            "properties": {
              "device_id": {
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/Kind"
              },
              "mounted": {
                "$ref": "#/$defs/Known",
                "description": "Whether a file system on it is mounted. Unmounted storage still counts as attached."
              },
              "transport": {
                "$ref": "#/$defs/Transport"
              },
              "writable": {
                "$ref": "#/$defs/Known"
              }
            },
            "required": [
              "device_id",
              "kind",
              "transport",
              "mounted",
              "writable"
            ],
            "type": "object"
          },
          "Kind": {
            "enum": [
              "block_storage",
              "portable_device"
            ],
            "type": "string"
          },
          "Known": {
            "description": "A yes/no the OS may not state.",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "type": "string"
          },
          "Transport": {
            "enum": [
              "usb",
              "thunderbolt",
              "sd",
              "other",
              "unknown"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "$ref": "#/$defs/Coverage"
          },
          "devices": {
            "description": "At most [`MAX_DEVICES`], ordered by identity.",
            "items": {
              "$ref": "#/$defs/Device"
            },
            "type": "array"
          }
        },
        "required": [
          "coverage",
          "devices"
        ],
        "title": "StorageState",
        "type": "object"
      },
      "summary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Device counts by kind, derived only from the read devices.",
        "properties": {
          "block_storage": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "portable_devices": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "block_storage",
          "portable_devices"
        ],
        "title": "StorageSummary",
        "type": "object"
      }
    },
    "virtualization": {
      "state": {
        "$defs": {
          "Classification": {
            "enum": [
              "recognized_guest",
              "recognized_physical_or_root",
              "unknown"
            ],
            "type": "string"
          },
          "Hypervisor": {
            "enum": [
              "hyperv",
              "vmware",
              "virtualbox",
              "parallels",
              "qemu_kvm",
              "apple_virtualization",
              "xen",
              "other",
              "none_detected"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "classification": {
            "$ref": "#/$defs/Classification"
          },
          "hypervisor": {
            "$ref": "#/$defs/Hypervisor"
          }
        },
        "required": [
          "classification",
          "hypervisor"
        ],
        "title": "VirtualizationState",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  },
  "registry": {
    "baseline_rules": [
      {
        "capability": "display",
        "mode": "enforce",
        "phase": "both",
        "reason": "display.single_display_required",
        "requirement": {
          "All": {
            "conditions": [
              {
                "Compare": {
                  "field": "display.summary.connected_total",
                  "op": "eq",
                  "value": 1
                }
              },
              {
                "Compare": {
                  "field": "display.summary.active_physical",
                  "op": "eq",
                  "value": 1
                }
              }
            ]
          }
        },
        "rule_id": "baseline.single_display"
      },
      {
        "capability": "candidate_window",
        "mode": "enforce",
        "phase": "participation",
        "reason": "candidate_window.window_required",
        "requirement": {
          "All": {
            "conditions": [
              {
                "Compare": {
                  "field": "candidate_window.presence",
                  "op": "eq",
                  "value": "present"
                }
              },
              {
                "Compare": {
                  "field": "candidate_window.placement",
                  "op": "eq",
                  "value": "maximized"
                }
              },
              {
                "Compare": {
                  "field": "candidate_window.content_protection",
                  "op": "eq",
                  "value": "verified"
                }
              }
            ]
          }
        },
        "rule_id": "baseline.window"
      },
      {
        "capability": "interactive_session",
        "mode": "enforce",
        "phase": "both",
        "reason": "interactive_session.single_session_required",
        "requirement": {
          "All": {
            "conditions": [
              {
                "Compare": {
                  "field": "interactive_session.console_owner",
                  "op": "eq",
                  "value": "candidate"
                }
              },
              {
                "Compare": {
                  "field": "interactive_session.lock",
                  "op": "eq",
                  "value": "unlocked"
                }
              },
              {
                "Compare": {
                  "field": "interactive_session.remote_attachment",
                  "op": "eq",
                  "value": "absent"
                }
              },
              {
                "Compare": {
                  "field": "interactive_session.other_human_sessions",
                  "op": "eq",
                  "value": 0
                }
              }
            ]
          }
        },
        "rule_id": "baseline.session"
      }
    ],
    "capabilities": [
      {
        "app_conditions": false,
        "categories": [],
        "fields": [
          {
            "max": 32,
            "name": "display.summary.active_physical",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.active_total",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.connected_total",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.mirrored",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.virtual",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.wireless",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.remote",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.specialized",
            "type": "count"
          },
          {
            "max": 32,
            "name": "display.summary.unknown_kind",
            "type": "count"
          }
        ],
        "id": "display",
        "permission_prompt": false,
        "reasons": [
          "display.single_display_required"
        ],
        "sensitive": false,
        "stability_ms": 1000
      },
      {
        "app_conditions": false,
        "categories": [],
        "fields": [
          {
            "name": "candidate_window.presence",
            "type": "symbol",
            "values": [
              "present",
              "absent"
            ]
          },
          {
            "name": "candidate_window.focus",
            "type": "symbol",
            "values": [
              "focused",
              "not_focused",
              "unknown"
            ]
          },
          {
            "name": "candidate_window.visibility",
            "type": "symbol",
            "values": [
              "visible",
              "hidden",
              "unknown"
            ]
          },
          {
            "name": "candidate_window.placement",
            "type": "symbol",
            "values": [
              "maximized",
              "normal",
              "minimized",
              "fullscreen",
              "unknown"
            ]
          },
          {
            "name": "candidate_window.content_protection",
            "type": "symbol",
            "values": [
              "verified",
              "failed",
              "unknown"
            ]
          },
          {
            "name": "candidate_window.occlusion",
            "type": "symbol",
            "values": [
              "none",
              "covered",
              "unknown"
            ]
          },
          {
            "max": 1000000,
            "name": "candidate_window.close_attempts",
            "type": "count"
          }
        ],
        "id": "candidate_window",
        "permission_prompt": false,
        "reasons": [
          "candidate_window.window_required",
          "candidate_window.covered",
          "candidate_window.focus_lost"
        ],
        "sensitive": false,
        "stability_ms": 1000
      },
      {
        "app_conditions": false,
        "categories": [],
        "fields": [
          {
            "name": "interactive_session.console_owner",
            "type": "symbol",
            "values": [
              "candidate",
              "other_human",
              "none",
              "unknown"
            ]
          },
          {
            "name": "interactive_session.lock",
            "type": "symbol",
            "values": [
              "unlocked",
              "locked",
              "unknown"
            ]
          },
