{
  "title": "Assistant text delta",
  "description": "One chunk of the assistant's reply, numbered from zero within the turn. Deltas are hints: a client that misses one reloads the transcript.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exam_sitting_id",
    "exam_attempt_id",
    "turn_id",
    "index",
    "text"
  ],
  "properties": {
    "exam_sitting_id": {
      "$ref": "id.json"
    },
    "exam_attempt_id": {
      "$ref": "id.json"
    },
    "turn_id": {
      "$ref": "id.json"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
