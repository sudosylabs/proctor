{
  "title": "Invitation changed",
  "description": "Names an Invitation the addressed User issued, the state it reached and the scope it grants at. The accepting User is never included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invitation_id",
    "state",
    "scope_type",
    "scope_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "invitation_id": {
      "$ref": "id.json"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired",
        "superseded"
      ]
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "institution",
        "academic_unit",
        "class"
      ]
    },
    "scope_id": {
      "$ref": "id.json"
    }
  }
}
