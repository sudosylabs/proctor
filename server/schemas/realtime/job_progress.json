{
  "title": "Job progress",
  "description": "The progress a running Job last checkpointed. Present only for a Job type that reports progress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current",
    "total",
    "stage"
  ],
  "properties": {
    "current": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    }
  }
}
