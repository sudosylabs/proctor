<!--
Template properties (server/app/mail renderer):
  .Copy.Subject, .Copy.Preheader — localized subject and inbox preview
  .Copy.Institution — institution display name; empty when unknown
  .Copy.Kind — localized message kind shown above the heading
  .Copy.Heading, .Copy.Greeting, .Copy.Paragraphs — localized heading, greeting and body
  .Hero — optional emphasised detail: .Label, .Primary, .Secondary, .Code, .Struck
  .Facts — ordered labelled details: .Label, .Value, .Struck
  .AsideAlert — true for security notices; the aside precedes the action
  .Copy.AsideTitle, .Copy.AsideText — optional aside; both or neither
  .ActionURL — validated HTTPS action URL; empty when no action is offered
  .Copy.ActionLabel, .Copy.ActionNote, .Copy.ActionFallback, .Copy.ActionFallbackLink — action copy
  .Copy.Why, .Copy.Support, .Copy.SentBy — localized colophon
-->
<mjml>
  <mj-head>
    <mj-title>{{.Copy.Subject}}</mj-title>
    <mj-preview>{{.Copy.Preheader}}</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body background-color="#FFFFFF" width="600px">
    <mj-include path="./partials/message.mjml" />
  </mj-body>
</mjml>
